# Local environments and secrets
.venv/
venv/
.env
.env.*

# Python and test artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.checkpoint*-test-tmp/
.checkpoint*-validation-tmp/
.matplotlib-cache/
.coverage
htmlcov/
*.log
tmp/

# Private source statements and generated financial outputs
data/raw/*
!data/raw/.gitkeep
data/private/*
!data/private/.gitkeep
data/public/raw/*
!data/public/raw/.gitkeep
!data/public/raw/*/
data/public/raw/*/*
!data/public/raw/*/.gitkeep
data/public/processed/*
!data/public/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
config/private*.yaml
config/**/*private*.yaml
*.pdf
*.csv
*.xlsx
*validation*.json
.checkpoint5-research/

# Generated EDA outputs
reports/private/
!reports/public/*.csv

# Notebook state or notebooks explicitly used with private data
.ipynb_checkpoints/
notebooks/private/
notebooks/**/*private*.ipynb
